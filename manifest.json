{
  "manifest_version": 3,
  "name": "Little Lovebug",
  "version": "1.3.3",
  "description": "A tiny white kitten carrying a little extra love through your day.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Little Lovebug"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "messages.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pet.svg",
        "pet.css",
        "pet-sprites.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
